# ------------------------------------------------------------------
# LugunaVoice environment — copy to .env.local and fill in
# ------------------------------------------------------------------

# Supabase (https://supabase.com/dashboard → project → Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Postgres connection string (Settings → Database → Connection string)
DATABASE_URL=

# TTS providers
# Typecast: https://typecast.ai → API Console (Lite plan $15/mo)
TYPECAST_API_KEY=
# Deepgram: https://deepgram.com → Console (PayGo, $200 trial credit)
DEEPGRAM_API_KEY=
DEEPGRAM_PROJECT_ID=

# Payments (Razorpay: https://razorpay.com → Dashboard)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Admin dashboard (password for /admin; leave empty for open dev mode)
ADMIN_PASSWORD=

# Cloudflare Turnstile (https://dash.cloudflare.com → Turnstile)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# OpenAI (content moderation only — free) https://platform.openai.com
OPENAI_API_KEY=

# Sentry (optional, free tier) https://sentry.io
NEXT_PUBLIC_SENTRY_DSN=

# Resend (transactional email, free 100/day) https://resend.com
RESEND_API_KEY=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
